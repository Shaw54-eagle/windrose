# ---- Live market data (Alpaca) ----
# Your Alpaca *paper* keys work fine — the data API is separate from trading.
# Make new ones at https://app.alpaca.markets  (Paper account -> API Keys).
# Without these, the dashboard falls back to delayed yfinance quotes.
ALPACA_KEY=your_alpaca_key_here
ALPACA_SECRET=your_alpaca_secret_here

# ---- News + analyst outlook (Finnhub, free) ----
# Free key at https://finnhub.io/register
FINNHUB_KEY=your_finnhub_key_here
